generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Core School setup
// ----------------------------------------------------------------------------
model School {
  id          String @id @default(uuid())
  name        String
  startTime   String // "08:00"
  endTime     String // "14:00"
  workingDays String // "[1, 2, 3, 4, 5]" (Monday-Friday)
}

model Class {
  id        String          @id @default(uuid())
  grade     Int // 1-10
  section   String // A, B, C
  // Relations
  students  Student[]
  timetable TimetableSlot[]
}

model Subject {
  id          String           @id @default(uuid())
  name        String
  category    String // Core, Science-Stream, Language, IT, Extracurricular
  requiresLab Boolean          @default(false)
  labType     String? // science, computer, none
  duration    Int              @default(40) // Duration in minutes
  // Relations
  teachers    TeacherSubject[]
  timetable   TimetableSlot[]
  homework    Homework[]
}

model Lab {
  id        String          @id @default(uuid())
  name      String
  type      String // science, computer
  equipment String
  capacity  Int
  // Relations
  timetable TimetableSlot[]
}

// ----------------------------------------------------------------------------
// Users
// ----------------------------------------------------------------------------
model Admin {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
}

model Teacher {
  id                      String           @id @default(uuid())
  name                    String
  employeeId              String           @unique
  passwordHash            String
  contactInfo             String?
  weeklyLeisurePreference Int              @default(3) // Min 1 leisure lecture on 3 days
  // Relations
  subjects                TeacherSubject[]
  assignedClasses         String // E.g., JSON array or stringified IDs of classes
  timetable               TimetableSlot[]
  homework                Homework[]
  substitutionsOriginal   Substitution[]   @relation("OriginalTeacher")
  substitutionsSubstitute Substitution[]   @relation("SubstituteTeacher")
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
}

model Student {
  id           String       @id @default(uuid())
  name         String
  classId      String
  class        Class        @relation(fields: [classId], references: [id])
  rollNumber   String
  passwordHash String
  parentId     String?
  parent       Parent?      @relation(fields: [parentId], references: [id])
  // Relations
  attendance   Attendance[]
  fees         Fee[]
  badges       Badge[]

  @@unique([classId, rollNumber])
}

model Parent {
  id           String    @id @default(uuid())
  name         String
  contact      String    @unique
  passwordHash String
  regionalLang String    @default("en")
  // Relations
  children     Student[]
}

// ----------------------------------------------------------------------------
// Operations (Timetable, Attendance, etc.)
// ----------------------------------------------------------------------------
model TimetableSlot {
  id                String  @id @default(uuid())
  dayOfWeek         Int // 1 = Mon, ..., 5 = Fri
  startTime         String // e.g., "08:00"
  endTime           String // e.g., "08:40"
  isExtracurricular Boolean @default(false)

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id])
}

model Substitution {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String
  endTime   String
  classId   String
  reason    String?

  originalTeacherId String
  originalTeacher   Teacher @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])

  substituteTeacherId String?
  substituteTeacher   Teacher? @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  date      DateTime
  status    String // "present", "absent"
  mode      String // "manual", "qr"
  markedBy  String // Teacher ID or "student_qr"
  timestamp DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model Leave {
  id            String   @id @default(uuid())
  requesterId   String // Teacher ID or Student ID
  requesterRole String // "teacher", "student"
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        String   @default("pending") // pending, approved, rejected
  approverId    String?
}

model Notice {
  id           String   @id @default(uuid())
  authorId     String
  textEnglish  String
  translations String // JSON string of { "hi": "...", "pa": "..." }
  audience     String // "all", "teachers", "parents"
  createdAt    DateTime @default(now())
}

model Homework {
  id         String   @id @default(uuid())
  title      String
  contentUrl String?
  dueDate    DateTime
  uploadDate DateTime @default(now())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Fee {
  id             String   @id @default(uuid())
  amount         Float
  dueDate        DateTime
  status         String // "pending", "paid", "overdue"
  paymentHistory String? // JSON array of payment events

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
}

model Badge {
  id          String   @id @default(uuid())
  badgeType   String // "100_attendance", "early_homework"
  earnedDate  DateTime @default(now())
  streakCount Int      @default(0)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
}

// ----------------------------------------------------------------------------
// AI Tutor Vector Store
// ----------------------------------------------------------------------------
model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String // The text chunk
  embedding String // JSON stringified number[] array for local cosine similarity
  createdAt DateTime @default(now())
}
